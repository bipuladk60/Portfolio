# Live Warmer search data (Google Search Console). Optional: without these the page shows the
# content.ts snapshot. Read at build time only. Copy to .env.local (git-ignored) for local builds;
# for the deployed site, add them as GitHub Actions secrets.
GSC_CLIENT_EMAIL=warmer-search@your-project.iam.gserviceaccount.com
# The "private_key" field from the service-account JSON, on one line with literal \n escapes, in quotes.
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Optional. Defaults to the Domain property sc-domain:warmergames.com.
# GSC_SITE_URL=sc-domain:warmergames.com
